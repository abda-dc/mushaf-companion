{
  "name": "mushaf-companion",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --port 5550",
    "build": "vinext build",
    "start": "vinext start --port 5550",
    "test": "npm run build && node --test tests/*.test.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .npm-cache --ignore-pattern .wrangler --ignore-pattern outputs --ignore-pattern build --ignore-pattern public --ignore-pattern github-pages --ignore-pattern android --ignore-pattern ios --ignore-pattern mobile-shell",
    "db:generate": "drizzle-kit generate",
    "mobile:sync": "cap sync",
    "mobile:android": "cap sync android",
    "mobile:ios": "cap sync ios",
    "mobile:android:debug": "npm run mobile:android && cd android && gradlew.bat assembleDebug",
    "mobile:android:bundle": "npm run mobile:android && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
