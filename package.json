{
  "name": "mushaf-companion",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --port 5550",
    "build": "vinext build",
    "build:pages": "node --experimental-strip-types scripts/build-pages.mjs",
    "build:native": "node --experimental-strip-types scripts/build-native.mjs",
    "verify:native": "node --experimental-strip-types scripts/verify-native-artifact.mjs",
    "smoke:native": "node scripts/smoke-native.mjs",
    "verify:pages": "node scripts/verify-pages-artifact.mjs",
    "serve:pages": "node scripts/serve-pages.mjs",
    "smoke:pages": "node scripts/smoke-pages.mjs",
    "start": "vinext start --port 5550",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:translations": "node --experimental-strip-types scripts/audit-translations.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .npm-cache --ignore-pattern .wrangler --ignore-pattern outputs --ignore-pattern work --ignore-pattern build --ignore-pattern public --ignore-pattern github-pages --ignore-pattern _site --ignore-pattern native-runtime --ignore-pattern android --ignore-pattern ios --ignore-pattern mobile-shell",
    "db:generate": "drizzle-kit generate",
    "mobile:sync": "npm run build:native && cap sync",
    "mobile:android": "npm run build:native && cap sync android",
    "mobile:ios": "npm run build:native && cap sync ios",
    "mobile:android:debug": "npm run mobile:android && cd android && gradlew.bat assembleDebug",
    "mobile:android:bundle": "npm run mobile:android && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "8.3.1",
    "adhan": "4.4.4",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
